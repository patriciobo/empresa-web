---
import Cierre from "../components/Cierre.astro";
import IndiceProyectos from "../components/IndiceProyectos.astro";
import PlanesTabla from "../components/PlanesTabla.astro";
import Preguntas from "../components/Preguntas.astro";
import SeccionCabeza from "../components/SeccionCabeza.astro";
import { FAQ, PRECIO_DESDE, PROCESO, SERVICIOS } from "../content";
import { PROYECTOS, RUBROS } from "../data";
import Editorial from "../layouts/Editorial.astro";
import { agendaLink, SITE } from "../site";

const n2 = (i: number) => String(i + 1).padStart(2, "0");
const rubrosLargos = [...new Set(PROYECTOS.map((p) => p.rubro))];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.map((f) => ({ "@type": "Question", name: f.p, acceptedAnswer: { "@type": "Answer", text: f.r } })),
};
---

<Editorial
  title="Software, web y marca para negocios que crecen"
  description={`${SITE.nombre}: estudio de tecnología en Córdoba. Sistemas de gestión, sitios web y marca para emprendedores, por suscripción mensual y sin inversión inicial grande.`}
  schema={[faqSchema]}
  preloadHero
>
  <section class="hero foto-sangre">
    <img
      class="foto-sangre__img hero__foto"
      src="/alt/fuego-hero.webp"
      srcset="/alt/fuego-hero-800.webp 800w, /alt/fuego-hero.webp 1600w"
      sizes="100vw"
      alt=""
      width="1600"
      height="1067"
      fetchpriority="high"
    />
    <div class="foto-sangre__velo" aria-hidden="true"></div>
    <div class="foto-sangre__grano" aria-hidden="true"></div>

    <div class="hero__arriba">
      <span class="ed-mono">(Estudio de tecnología)</span>
      <span class="ed-mono hero__derecha">Software · Web · Marca · Datos</span>
    </div>

    <h1 class="hero__titulo">Software, web y marca para negocios que quieren <span>crecer ordenados.</span></h1>

    <div class="hero__abajo">
      <p class="hero__bajada">
        Diseñamos y desarrollamos los sistemas con los que un emprendimiento gestiona, mide y planifica. Gestionar tu
        negocio de forma inteligente no es solo para empresas grandes: desde {PRECIO_DESDE} por mes.
      </p>
      <ul class="hero__datos ed-mono">
        <li><b>{String(PROYECTOS.length).padStart(2, "0")}</b> soluciones en uso</li>
        <li><b>{String(RUBROS.length).padStart(2, "0")}</b> rubros</li>
        <li><b>{PRECIO_DESDE}</b> por mes, desde</li>
      </ul>
      <a class="ed-link hero__cta" href={agendaLink}>Agendar charla inicial <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <div class="cinta" aria-label={`Rubros: ${rubrosLargos.join(", ")}`}>
    <div class="cinta__pista" aria-hidden="true">
      {[0, 1].map(() => rubrosLargos.map((r) => <span>{r}<i>✳</i></span>))}
    </div>
  </div>

  <section class="bloque" id="proyectos" aria-labelledby="t-proyectos">
    <SeccionCabeza num="01" id="t-proyectos" titulo="Índice de proyectos" nota={`${PROYECTOS.length} sistemas en uso, ${RUBROS.length} rubros`} />
    <IndiceProyectos proyectos={PROYECTOS} />
  </section>

  <section class="bloque bloque--claro manifiesto">
    <span class="ed-mono">(02) Enfoque</span>
    <p class="manifiesto__texto">
      No vendemos tecnología. Ordenamos negocios. Primero entendemos cómo trabajás; después diseñamos el sistema, lo
      ponemos en marcha en semanas y lo mejoramos cada mes con tus números.
    </p>
  </section>

  <section class="bloque" id="servicios" aria-labelledby="t-servicios">
    <SeccionCabeza num="03" id="t-servicios" titulo="Qué hacemos" nota="Un solo equipo, seis disciplinas" />
    <ul class="filas">
      {
        SERVICIOS.map((s, i) => (
          <li class="servicio" id={s.id}>
            <span class="ed-mono ed-gris">{n2(i)}</span>
            <h3>{s.titulo}</h3>
            <p class="servicio__bajada">{s.bajada}</p>
            <ul class="lista-mono">
              {s.items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bloque" aria-labelledby="t-metodo">
    <SeccionCabeza num="04" id="t-metodo" titulo="Método" nota="De la primera charla a usarlo en semanas" />
    <ol class="metodo">
      {
        PROCESO.map((p, i) => (
          <li>
            <span class="metodo__num">{n2(i)}</span>
            <h3>{p.paso}</h3>
            <span class="ed-mono ed-acento">{p.cobro}</span>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="bloque" id="planes" aria-labelledby="t-planes">
    <SeccionCabeza num="05" id="t-planes" titulo="Planes" nota="Suscripción mensual, sin inversión inicial grande" />
    <PlanesTabla />
    <p class="mas">
      <a class="ed-link" href="/como-trabajamos">Cómo trabajamos y cuándo se paga <span aria-hidden="true">→</span></a>
      <a class="ed-link" href="/planes">Comparar con un desarrollo de pago único <span aria-hidden="true">→</span></a>
    </p>
  </section>

  <section class="bloque" aria-labelledby="t-faq">
    <SeccionCabeza num="06" id="t-faq" titulo="Preguntas" nota="Lo que nos preguntan antes de empezar" />
    <Preguntas />
  </section>

  <Cierre etiqueta="(07) Charla inicial sin costo · 30 min" />
</Editorial>

<style>
  .hero {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 84px var(--pad) var(--pad);
  }
  .hero__foto {
    object-position: 30% 70%;
    transform: scale(1.04);
    animation: respira 9s ease-in-out infinite alternate;
  }
  @keyframes respira {
    to {
      transform: scale(1.1);
    }
  }
  .hero__arriba {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid var(--linea);
    padding-top: 12px;
  }
  .hero__derecha {
    text-align: right;
  }
  .hero__titulo {
    align-self: end;
    font-size: clamp(2.6rem, 8.4vw, 9.5rem);
    max-width: 14ch;
    padding-block: clamp(32px, 6vw, 64px);
  }
  .hero__titulo span {
    color: var(--brasa);
  }
  .hero__abajo {
    display: grid;
    gap: 20px;
    border-top: 1px solid var(--linea);
    padding-top: 16px;
  }
  .hero__bajada {
    max-width: 46ch;
    color: var(--hueso-2);
  }
  .hero__datos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
  }
  .hero__datos b {
    color: var(--brasa);
    font-weight: 500;
    margin-right: 4px;
  }
  .hero__cta {
    justify-self: start;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
  }
  @media (min-width: 900px) {
    .hero__abajo {
      grid-template-columns: 1.3fr 1fr auto;
      align-items: end;
    }
    .hero__cta {
      justify-self: end;
    }
  }

  .cinta {
    border-block: 1px solid var(--linea);
    overflow: hidden;
    padding-block: 18px;
  }
  .cinta__pista {
    display: flex;
    width: max-content;
    animation: cinta 40s linear infinite;
  }
  .cinta__pista span {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    font-size: clamp(1.6rem, 4vw, 3.2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px var(--hueso-2);
  }
  .cinta__pista i {
    font-style: normal;
    color: var(--brasa);
    -webkit-text-stroke: 0;
    font-size: 0.6em;
  }
  @keyframes cinta {
    to {
      transform: translateX(-50%);
    }
  }

  .manifiesto {
    display: grid;
    gap: 28px;
  }
  .manifiesto .ed-mono {
    border-top: 1px solid var(--linea-oscura);
    padding-top: 14px;
  }
  .manifiesto__texto {
    font-size: clamp(1.8rem, 4.4vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.04;
    max-width: 22ch;
    text-wrap: balance;
  }

  .servicio {
    display: grid;
    gap: 10px 24px;
    padding: 28px 0;
    scroll-margin-top: 80px;
  }
  .servicio h3 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
  }
  .servicio__bajada {
    color: var(--hueso-2);
    max-width: 44ch;
  }
  @media (min-width: 900px) {
    .servicio {
      grid-template-columns: 4rem 1.4fr 1.6fr 1.6fr;
      align-items: start;
    }
  }

  .metodo {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    border-top: 1px solid var(--linea);
  }
  .metodo li {
    padding: 24px 24px 32px 0;
    border-bottom: 1px solid var(--linea);
  }
  .metodo__num {
    display: block;
    font-size: clamp(3.4rem, 7vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--brasa);
    margin-bottom: 20px;
  }
  .metodo h3 {
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    margin-bottom: 10px;
  }
  .metodo li > .ed-mono {
    display: block;
    margin-bottom: 10px;
  }
  .metodo p {
    color: var(--hueso-2);
  }
  @media (min-width: 900px) {
    .metodo li + li {
      border-left: 1px solid var(--linea);
      padding-left: 24px;
    }
  }
  .mas {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }
</style>
