---
import { AUTODIAGNOSTICO, PERFIL } from "../content";
import SeccionCabeza from "../components/SeccionCabeza.astro";
import Editorial from "../layouts/Editorial.astro";
import { SITE } from "../site";

const opciones = [
  { v: 2, t: "Sí" },
  { v: 1, t: "A medias" },
  { v: 0, t: "No" },
];
const total = AUTODIAGNOSTICO.length + PERFIL.length;
---

<Editorial
  title="Autodiagnóstico"
  description="En 2 minutos, descubrí qué tan ordenado y medible está tu negocio en presencia online, marca, procesos y datos, y qué plan te conviene."
>
  <section class="bloque cabeza">
    <SeccionCabeza num="01" titulo="Autodiagnóstico" nota={`${total} preguntas · 2 minutos`} h1 />
    <p class="intro">
      ¿Qué tan preparado está tu negocio para crecer? Respondé y te mostramos tu puntaje en presencia online, marca,
      procesos y datos, y cuál de nuestros tres planes te conviene.
    </p>

    <form id="form" data-whatsapp={SITE.whatsapp} data-email={SITE.email}>
      {
        PERFIL.map((q, i) => (
          <fieldset>
            <legend>
              <span class="ed-mono ed-gris">{String(i + 1).padStart(2, "0")} · Tu negocio</span>
              {q.pregunta}
            </legend>
            <div class="opciones">
              {q.opciones.map((o) => (
                <label class="opcion">
                  <input type="radio" name={q.id} value={o.v} required />
                  <span>{o.t}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }
      {
        AUTODIAGNOSTICO.map((q, i) => (
          <fieldset data-area={q.area}>
            <legend>
              <span class="ed-mono ed-gris">{String(PERFIL.length + i + 1).padStart(2, "0")} · {q.area}</span>
              {q.pregunta}
            </legend>
            <div class="opciones">
              {opciones.map((o) => (
                <label class="opcion">
                  <input type="radio" name={`q${i}`} value={o.v} required />
                  <span>{o.t}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }
      <button class="enviar" type="submit">Ver mi resultado <span aria-hidden="true">→</span></button>
    </form>

    <div id="resultado" class="resultado" hidden aria-live="polite">
      <p class="ed-mono ed-gris">Tu resultado</p>
      <p class="resultado__total"><strong id="total"></strong><span class="ed-mono"> / 100</span></p>
      <div id="areas" class="areas"></div>
      <div class="plan-sugerido">
        <p class="ed-mono ed-acento">Plan recomendado</p>
        <p class="plan-sugerido__nombre"><span id="plan-nombre"></span> <span class="ed-mono" id="plan-precio"></span></p>
        <p id="plan-motivo"></p>
        <ul id="plan-incluye" class="lista-mono"></ul>
        <p class="ed-mono ed-gris" id="plan-nota"></p>
      </div>
      <div class="recomendacion">
        <p class="ed-mono ed-acento">Primer paso</p>
        <p id="primer-paso"></p>
      </div>
      <div class="resultado__botones">
        <a id="enviar" class="ed-link" href="#">Enviar mi resultado y agendar la charla <span aria-hidden="true">→</span></a>
        <button class="ed-mono reiniciar" type="button" id="reiniciar">Volver a empezar</button>
      </div>
      <p class="ed-mono ed-gris">No guardamos tus respuestas: el resultado se calcula en tu navegador.</p>
    </div>
  </section>
</Editorial>

<script>
  import { clasificar } from "../content";

  const form = document.getElementById("form") as HTMLFormElement;
  const res = document.getElementById("resultado") as HTMLElement;
  const $ = (id: string) => document.getElementById(id)!;

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const puntos: Record<string, { s: number; max: number }> = {};
    for (const fs of form.querySelectorAll<HTMLFieldSetElement>("fieldset[data-area]")) {
      const area = fs.dataset.area!;
      const v = Number(fs.querySelector<HTMLInputElement>("input:checked")?.value ?? 0);
      puntos[area] ??= { s: 0, max: 0 };
      puntos[area].s += v;
      puntos[area].max += 2;
    }
    const pct = Object.entries(puntos).map(([area, { s, max }]) => ({ area, pct: Math.round((s / max) * 100) }));
    const total = Math.round(pct.reduce((a, b) => a + b.pct, 0) / pct.length);
    const datos = new FormData(form);
    const { plan, motivo, nota } = clasificar({
      pct: Object.fromEntries(pct.map((p) => [p.area, p.pct])),
      equipo: String(datos.get("equipo")),
      areas: String(datos.get("areas")),
    });

    $("total").textContent = String(total);
    $("areas").innerHTML = pct
      .map((p) => `<div class="area"><span>${p.area}</span><div class="barra"><i style="width:${p.pct}%"></i></div><b>${p.pct}%</b></div>`)
      .join("");
    $("plan-nombre").textContent = plan.nombre;
    $("plan-precio").textContent = plan.desde === null ? "a medida" : `desde ${plan.moneda} ${plan.desde} / mes`;
    $("plan-motivo").textContent = motivo;
    $("plan-incluye").innerHTML = plan.incluye
      .filter((i) => !i.startsWith("Todo lo de") && !i.startsWith("Opcional"))
      .slice(0, 3)
      .map((i) => `<li>${i}</li>`)
      .join("");
    $("plan-nota").textContent = nota;
    $("primer-paso").textContent =
      plan.id === "integral"
        ? "Una charla inicial sin costo y después un relevamiento profundo de tu operación, que se descuenta de tu primer mes si avanzás."
        : `Una charla inicial sin costo y después el relevamiento y la propuesta: 1 cuota del plan ${plan.nombre}, que vale como tu primer mes si avanzás.`;

    const texto = `Hola, hice el autodiagnóstico: ${total}/100 (${pct.map((p) => `${p.area} ${p.pct}%`).join(", ")}). Me salió el plan ${plan.nombre}. Quiero agendar la charla inicial.`;
    const wa = form.dataset.whatsapp;
    (document.getElementById("enviar") as HTMLAnchorElement).href = wa
      ? `https://wa.me/${wa}?text=${encodeURIComponent(texto)}`
      : `mailto:${form.dataset.email}?subject=${encodeURIComponent("Mi autodiagnóstico")}&body=${encodeURIComponent(texto)}`;

    form.hidden = true;
    res.hidden = false;
    res.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  $("reiniciar").addEventListener("click", () => {
    form.reset();
    res.hidden = true;
    form.hidden = false;
  });
</script>

<style>
  .cabeza {
    padding-top: 120px;
  }
  .intro {
    max-width: 56ch;
    color: var(--hueso-2);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    margin-bottom: 40px;
  }
  form {
    border-top: 1px solid var(--linea);
    max-width: 900px;
  }
  fieldset {
    border: 0;
    border-bottom: 1px solid var(--linea);
    margin: 0;
    padding: 24px 0;
  }
  legend {
    float: left;
    width: 100%;
    display: grid;
    gap: 8px;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 16px;
  }
  .opciones {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .enviar {
    margin-top: 32px;
    background: var(--brasa);
    color: var(--negro);
    border: 0;
    padding: 16px 24px;
    font: inherit;
    font-weight: 600;
    font-size: 1.1rem;
    cursor: pointer;
  }
  .enviar:hover {
    background: var(--hueso);
  }
  .resultado {
    display: grid;
    gap: 28px;
    max-width: 900px;
    border-top: 1px solid var(--linea);
    padding-top: 14px;
    scroll-margin-top: 90px;
  }
  .resultado__total strong {
    font-size: clamp(5rem, 16vw, 12rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.9;
    color: var(--brasa);
  }
  .areas {
    display: grid;
    border-top: 1px solid var(--linea);
  }
  .areas :global(.area) {
    display: grid;
    grid-template-columns: 7rem 1fr 3.5rem;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--linea);
  }
  .areas :global(.area span) {
    font-family: var(--mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .areas :global(.barra) {
    height: 6px;
    background: var(--linea);
  }
  .areas :global(.barra i) {
    display: block;
    height: 100%;
    background: var(--brasa);
  }
  .areas :global(b) {
    text-align: right;
    font-weight: 500;
  }
  .plan-sugerido {
    display: grid;
    gap: 12px;
    border: 1px solid var(--brasa);
    padding: 24px;
  }
  .plan-sugerido__nombre {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  .plan-sugerido__nombre .ed-mono {
    font-size: 0.9rem;
    letter-spacing: 0;
    color: var(--gris);
  }
  #plan-motivo {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    max-width: 48ch;
  }
  .recomendacion {
    display: grid;
    gap: 10px;
  }
  .recomendacion p:last-child {
    font-size: clamp(1.2rem, 2.2vw, 1.7rem);
    letter-spacing: -0.03em;
    line-height: 1.25;
    max-width: 44ch;
  }
  .resultado__botones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    font-size: 1.2rem;
  }
  .reiniciar {
    background: none;
    border: 0;
    color: var(--hueso-2);
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
